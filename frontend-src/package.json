{
  "name": "automation-pause-card",
  "version": "0.0.0",
  "private": true,
  "description": "Lovelace card of the Automation Pause and Resume integration.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write . && eslint . --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@mdi/js": "7.4.47",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-lit": "2.3.1",
    "eslint-plugin-lit-a11y": "5.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "eslint-plugin-wc": "3.1.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
